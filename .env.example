# =============================================================================
# ApexChainx Backend — environment configuration template
# =============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env. It is gitignored; this template is the tracked reference.
#
# HOW THIS FILE IS VERIFIED
# tests/test_env_example_completeness.py asserts that every field on
# `app.core.config.Settings` appears below, that every key below is a real
# setting, and that the values here pass validate_critical_settings() for local
# development. Adding a setting to config.py without documenting it here fails
# that test.
#
# DEV vs PROD — THE ONE KNOB THAT MATTERS
#   ENVIRONMENT=local (or test) is the only mode where the dev-only defaults
#   below are accepted. Set ENVIRONMENT=staging or production and the startup
#   guard in validate_critical_settings() additionally requires:
#     * SECRET_KEY                      non-default, >= 32 chars
#     * IMPERSONATION_SIGNING_KEY       >= 32 chars if set
#     * PAYMENT_WEBHOOK_SECRET          non-empty
#     * WEBHOOK_SECRET_ENCRYPTION_KEY   non-empty and a valid Fernet key
#   Set CELERY_TASK_ALWAYS_EAGER=false and CELERY_BROKER_URL /
#   CELERY_RESULT_BACKEND must both be non-empty.
#
# STARTUP GUARDS (validate_critical_settings, app/core/config.py)
# The app refuses to boot, listing every problem at once, when:
#   * PROJECT_NAME, VERSION, DATABASE_URL, PAYMENT_ASSET_CODE,
#     PAYMENT_FROM_ADDRESS or PAYMENT_TO_ADDRESS is empty
#   * API_V1_PREFIX does not start with "/" (or ends with "/" when not "/")
#   * DATABASE_URL has no URL scheme
#   * ALLOWED_ORIGINS is empty, contains "*", or has a non-http(s) origin
#   * STELLAR_NETWORK is not testnet|mainnet|futurenet|standalone
#   * CONTRACT_EXECUTION_MODE is not local_adapter|soroban_rpc
#   * CELERY_TASK_ALWAYS_EAGER=false with an empty broker or result URL
#   * TRUSTED_PROXY_COUNT < 0
#   * WEBHOOK_RETRY_BASE_DELAYS is not a comma-separated list of ints >= 0
#   * WEBHOOK_RETRY_MAX_DELAY_SECONDS <= 0
#   * WEBHOOK_MAX_CONCURRENT_DISPATCHES[_PER_WEBHOOK] <= 0
#   * the non-local SECRET_KEY / webhook-secret rules above are violated
#
# SECURITY GUIDANCE
#   * Generate every secret below; never ship a placeholder to a real env.
#   * Use a secrets manager (AWS Secrets Manager, Vault) in production.
#   * Use different secrets per environment; rotate on any suspected exposure.
#   * Never write a Stellar SECRET key (starts with "S") to this file or any
#     tracked file — inject it at runtime.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Required outside local/test
# -----------------------------------------------------------------------------
# SECRET_KEY signs JWT access tokens. A leak means token forgery.
#   generate: openssl rand -hex 32
SECRET_KEY=[GENERATE_SECURE_RANDOM_STRING]

# Dedicated key for impersonation tokens. Unset falls back to SECRET_KEY;
# set a separate value in production so one leak does not compromise both.
#   generate: openssl rand -hex 32
# IMPERSONATION_SIGNING_KEY=

# HMAC secret for verifying inbound webhook signatures.
#   generate: openssl rand -hex 32
# PAYMENT_WEBHOOK_SECRET=[GENERATE_SECURE_RANDOM_STRING_FOR_WEBHOOK_SIG]

# Fernet key (32 url-safe base64-encoded bytes) that encrypts outbound webhook
# signing secrets at rest. Required when ENVIRONMENT is not local/test; unset
# locally, a key is derived from SECRET_KEY.
#   generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WEBHOOK_SECRET_ENCRYPTION_KEY=

# Stellar secret keys MUST be injected at runtime, never written here.
# STELLAR_POOL_SECRET_KEY=INJECT_VIA_ENVIRONMENT_OR_SECRETS_MANAGER


# -----------------------------------------------------------------------------
# 2. Environment mode
# -----------------------------------------------------------------------------
# local | test          -> dev defaults accepted
# staging | production  -> the guards in section 1 are enforced
ENVIRONMENT=local

# Set true only for a local debugging session; leaks stack traces.
DEBUG=false

PROJECT_NAME=ApexChainx API
VERSION=1.0.0


# -----------------------------------------------------------------------------
# 3. API, CORS and security headers
# -----------------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# No "*": a wildcard origin is rejected at startup.
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
CORS_ALLOWED_METHODS=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
CORS_ALLOWED_HEADERS=["Authorization", "X-Correlation-ID", "Idempotency-Key", "Content-Type", "X-Requested-With"]
CORS_EXPOSE_HEADERS=["X-Correlation-ID", "X-RateLimit-Remaining"]

# HSTS/CSP/X-Frame-Options and friends. Keep enabled in production.
SECURITY_HEADERS_ENABLED=true
# Loosens CSP only for the built-in /docs and /openapi.json pages.
SECURITY_CSP_SWAGGER_PERMISSIVE=false
# Path prefixes excluded from ETag response buffering (static assets, SSE).
ETAG_EXCLUDE_PATH_PREFIXES=[]

# Seconds to let in-flight requests finish on SIGTERM.
SHUTDOWN_GRACE_SECONDS=30


# -----------------------------------------------------------------------------
# 4. Database
# -----------------------------------------------------------------------------
# Strong password in production; never literally "password".
DATABASE_URL=postgresql://username:[STRONG_PASSWORD]@localhost:5432/apexchainx
# Separate cluster for the append-only audit log, when it is not the same DB.
# DATABASE_AUDIT_URL=postgresql://username:[STRONG_PASSWORD]@localhost:5432/apexchainx_audit

# SQLAlchemy pool sizing. Size the pool against the Postgres max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Recycle connections before an intermediary drops them (seconds).
DB_POOL_RECYCLE_SECONDS=1800


# -----------------------------------------------------------------------------
# 5. Auth, rate limiting and token revocation
# -----------------------------------------------------------------------------
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Distinct password prefixes that trip the credential-stuffing alert.
AUTH_LOCKOUT_ENTROPY_THRESHOLD=20
AUTH_CREDENTIAL_STUFFING_WINDOW_MINUTES=5
# Redis key namespace for revoked access tokens; change only to avoid collisions.
AUTH_REVOCATION_KEY_PREFIX=revoked_token
# false falls back to the in-process limiter — not safe across multiple workers.
USE_REDIS_RATE_LIMITER=true

# OAuth redirect URIs are matched against this allowlist.
OAUTH_REDIRECT_URI_ALLOWLIST=["http://localhost:3000/oauth/callback"]
OAUTH_STATE_TTL_SECONDS=600

# Idempotency-Key records are kept for this many hours.
IDEMPOTENCY_KEY_TTL_HOURS=24


# -----------------------------------------------------------------------------
# 6. Celery
# -----------------------------------------------------------------------------
# true runs tasks in-process: no Redis and no worker needed, for local dev only.
# false requires both URLs below to be non-empty, plus a running worker.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# 7. Input limits
# -----------------------------------------------------------------------------
MAX_REQUEST_BODY_SIZE_BYTES=10485760
MAX_FILE_UPLOAD_SIZE_BYTES=10485760
MAX_BULK_OUTAGES_COUNT=1000
MAX_WEBHOOK_PAYLOAD_SIZE_BYTES=1048576
MAX_AFFECTED_SERVICES_COUNT=100
MAX_SITE_NAME_LENGTH=255
MAX_DESCRIPTION_LENGTH=5000
MAX_WEBHOOK_EVENTS_COUNT=50
MAX_WEBHOOK_NAME_LENGTH=255
MAX_WEBHOOK_URL_LENGTH=2048


# -----------------------------------------------------------------------------
# 8. Webhook URL / SSRF policy
# -----------------------------------------------------------------------------
# false blocks callbacks into private, loopback and link-local ranges.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# When non-empty, only these hosts may receive a webhook.
WEBHOOK_URL_ALLOWLIST=[]
# Disables SSRF validation entirely. Local testing only.
WEBHOOK_URL_VALIDATOR_BYPASS=false

# Number of trusted reverse-proxy hops in front of the app. Only the Nth entry
# from the right of X-Forwarded-For is honoured, so clients cannot spoof their
# IP. 0 = no proxy, use the direct connection IP.
TRUSTED_PROXY_COUNT=0


# -----------------------------------------------------------------------------
# 9. Webhook retries, circuit breaker and dispatch concurrency
# -----------------------------------------------------------------------------
# Base backoff per retry attempt: 30 s, then 2 min, then 10 min. The list also
# caps the number of attempts a delivery can ever make.
WEBHOOK_RETRY_BASE_DELAYS=30,120,600
# Ceiling for any single computed delay, applied after jitter.
WEBHOOK_RETRY_MAX_DELAY_SECONDS=3600
# Jitter mode: none | equal | full. "full" spreads retries best.
WEBHOOK_RETRY_JITTER=full
WEBHOOK_MAX_CONCURRENT_DISPATCHES=10
WEBHOOK_MAX_CONCURRENT_DISPATCHES_PER_WEBHOOK=5
# Failures in WEBHOOK_BREAKER_WINDOW_SECONDS before deliveries are deferred.
WEBHOOK_BREAKER_FAIL_THRESHOLD=10
WEBHOOK_BREAKER_WINDOW_SECONDS=300
# How long the breaker stays open before a trial delivery is allowed.
WEBHOOK_BREAKER_RESET_SECONDS=600
# Hours the previous signing secret stays valid after a rotation.
WEBHOOK_SECRET_GRACE_HOURS=24


# -----------------------------------------------------------------------------
# 10. Stellar and contract execution
# -----------------------------------------------------------------------------
# testnet | mainnet | futurenet | standalone
STELLAR_NETWORK=testnet
SLA_CONTRACT_ADDRESS=local-sla-calculator
# local_adapter | soroban_rpc
CONTRACT_EXECUTION_MODE=local_adapter

# Stellar endpoints and keys are documented in docs/STELLAR_INTEGRATION.md and
# are not read from this file by app/core/config.py.
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_POOL_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# STELLAR_POOL_SECRET_KEY=INJECT_VIA_ENVIRONMENT_OR_SECRETS_MANAGER


# -----------------------------------------------------------------------------
# 11. Payments
# -----------------------------------------------------------------------------
# Stellar asset code used for SLA settlement (USDC on every network).
PAYMENT_ASSET_CODE=USDC
# Public key of the pool account that sends settlement payments.
PAYMENT_FROM_ADDRESS=your-pool-address-here
# Public key of the settlement account that receives them.
PAYMENT_TO_ADDRESS=your-settlement-address-here


# -----------------------------------------------------------------------------
# 12. Cache TTLs
# -----------------------------------------------------------------------------
# Seconds wallet balances and SLA results are considered fresh.
WALLET_CACHE_TTL_SECONDS=60
SLA_CACHE_TTL_SECONDS=60


# -----------------------------------------------------------------------------
# 13. Retention and audit
# -----------------------------------------------------------------------------
# Days outage timeline events are kept before cleanup removes them.
OUTAGE_EVENT_RETENTION_DAYS=90
# Days audit entries are kept before the scheduled task archives them.
AUDIT_RETENTION_DAYS=90
# Directory the archival task writes hashed JSONL bundles to.
AUDIT_ARCHIVE_DIR=audit_archives
# Audit detail keys whose values are replaced with [REDACTED] before writing.
AUDIT_SENSITIVE_FIELDS=["password", "hashed_password", "secret", "token", "access_token", "refresh_token", "authorization", "api_key", "x_api_key"]


# -----------------------------------------------------------------------------
# 14. External services
# -----------------------------------------------------------------------------
# Inject provider API keys at runtime from a secrets manager.
# EXAMPLE_API_KEY=INJECT_VIA_ENVIRONMENT_OR_SECRETS_MANAGER
